generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model barber {
  id          Int           @id @default(autoincrement())
  name        String
  experience  Int?
  reservation reservation[]
}

model customer {
  id          Int           @id @default(autoincrement())
  name        String
  email       String?       @unique(map: "Customer_email_key")
  phone       String?
  reservation reservation[]
}

model reservation {
  id         Int      @id @default(autoincrement())
  date       DateTime
  barberId   Int
  serviceId  Int
  customerId Int
  barber     barber   @relation(fields: [barberId], references: [id], map: "Reservation_barberId_fkey")
  customer   customer @relation(fields: [customerId], references: [id], map: "Reservation_customerId_fkey")
  service    service  @relation(fields: [serviceId], references: [id], map: "Reservation_serviceId_fkey")

  @@index([barberId], map: "Reservation_barberId_fkey")
  @@index([customerId], map: "Reservation_customerId_fkey")
  @@index([serviceId], map: "Reservation_serviceId_fkey")
}

model service {
  id          Int           @id @default(autoincrement())
  name        String
  price       Float
  duration    Int
  reservation reservation[]
}
